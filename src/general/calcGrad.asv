%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Description
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% This function calculates the temperature gradient and the heat flux based
% on the spatial temperature distribution T(x,t).
% -------------------------------------------------------------------------
% Inp:  1) data:        All input data
% Out:  1) q:           Temperature gradient (K/m)
%       2) qk:          Heat flux (W/m2)
%       3) out:         All output data

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Function
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function [q, qk, out] = calcGrad(data)
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %% Init
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %===================================================
    % Parameters
    %===================================================
    [Nt, ~] = size(data.y);                                              % number of output samples
    dx = data.tr.Data.dx;
    dy = data.tr.Data.dy;
    Ly = data.tr.Data.Ly;                                                      % length in y direction (m)
    Lx = data.tr.Data.Lx;                                                      % length in x direction (m)

    %===================================================
    % Variables
    %===================================================
    T = data.y;
    q = data.X;
    xInp = data.tr.Data.geo(:,1);                                              % sampled input values x (m)
    yInp = data.tr.Data.geo(:,2);                                              % sampled input values y (m)
    x = 0:dx:Lx;                                                            % x vector (m)
    y = 0:dy:Ly;                                                            % y vector (m)
    qk = zeros(Nt, length(y), length(x));

    %===================================================
    % Model
    %===================================================
    k = data.Data.k;


    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %% Pre-Processing
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    k = squeeze(map2D(k', xInp, yInp, x, y));
    T = squeeze(map2D(T, xInp, yInp, x, y));
    q = squeeze(map2D(q, xInp, yInp, x, y));
    

    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %% Calculation
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    for i = 1:Nt 
        %===================================================
        % Gradient
        %===================================================
        [dTdy, dTdx] = gradient(squeeze(T(i,:,:)), dy, dx);

        %===================================================
        % Flux
        %===================================================
        qk(i, :, :) = -(dTdx + dTdy);
        q(i, :, :) = k .* squeeze(qk(i,:,:));
    end

    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %% Output
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    out = data;
    out.q = q;
    out.qk = qk;
    
end

