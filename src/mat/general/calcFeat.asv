%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Description
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% This function calcualtes the features.
% -------------------------------------------------------------------------
% Inp:  1) Xout:    Extended feature vector
% Out:  1) data:    Input data
%       2) EWMA:    Exponentially Weighted Moving Average
%       3) EWMS:    Exponentially Weighted Moving Std

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Function
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function Xout = calcFeat(data, EWMA, EWMS)
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %% Message Input
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    disp("START: Calculation Features")

    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %% Init
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    [T, F] = size(data);
    Xout = data;

    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %% Calculation
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %===================================================
    % EWMA (Exponentially Weighted Moving Average)
    %===================================================
    if any(EWMA)
        for i = 1:length(EWMA)
            span = EWMA(i);
            alpha = 2 / (span + 1);
            Xewma = zeros(T, F);
            for f = 1:F
                Xewma(:, f) = ewma_single(data(:, f), alpha);
            end
            Xout = [Xout, Xewma];
        end
    end
    
    %===================================================
    % EWMS (Exponentially Weighted Moving Std)
    %===================================================
    if any(EWMS)
        for i = 1:length(EWMS)
            span = EWMS(i);
            alpha = 2 / (span + 1);
            Xewms = zeros(T, F);
            for f = 1:F
                Xewms(:, f) = ewms_single(data(:, f), alpha);
            end
            Xout = [Xout, Xewms];
        end
    end
    
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    %% Message Output
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    disp("DONE: Calculation Features")
end


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Functions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% =========================================================================
% Helper: EWMA function
% =========================================================================
function y = ewma(x, alpha)
    y = zeros(size(x));
    y(1) = x(1);
    for t = 2:length(x)
        y(t) = alpha * x(t) + (1 - alpha) * y(t-1);
    end
end

% =========================================================================
% Helper: EWMS (Exponentially Weighted Moving Std)
% =========================================================================
function y = ewms(x, alpha)
    mu = zeros(size(x));
    var = zeros(size(x));
    mu(1) = x(1);
    var(1) = 0;
    for t = 2:length(x)
        mu(t) = alpha * x(t) + (1 - alpha) * mu(t-1);
        var(t) = alpha * (x(t) - mu(t-1))^2 + (1 - alpha) * var(t-1);
    end
    y = sqrt(var);
end

